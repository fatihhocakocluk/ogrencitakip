rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Öğretmen: e-posta/şifre ile giren tek hesap (fatiher45@icloud.com)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'fatiher45@icloud.com';
    }
    function isParentOf(sid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/links/$(request.auth.uid + '_' + sid));
    }

    // Veli - öğrenci bağlantısı: veli çocuğun adını girince oluşur (öğrenci dosyası varsa)
    match /links/{id} {
      allow get: if isTeacher() || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.studentId
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId));
      allow delete: if isTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /students/{sid} {
      allow read: if isTeacher() || isParentOf(sid);
      allow create, update: if isTeacher();
      allow delete: if false;   // öğrenci dosyaları asla silinemez

      // lessons, exams, books, reports: öğretmen yazar, bağlı veli okur
      match /{col}/{docId} {
        allow read: if isTeacher() || isParentOf(sid);
        allow write: if isTeacher() && col != 'messages';
      }

      match /messages/{mid} {
        allow read: if isTeacher() || isParentOf(sid);
        allow create: if (isTeacher() && request.resource.data.from == 'ogretmen')
                      || (isParentOf(sid) && request.resource.data.from == 'veli');
        allow update, delete: if false;
      }
    }
  }
}
